[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "nextjs"
version = "0.0.32"
appliedPatches = [ ]

[env.OPENROUTER_API_KEY]
required = true

[env.OPENROUTER_AUDIO_MODEL]
default = "thinkingmachines/inkling"

[env.OPENROUTER_SCORING_MODEL]
default = "qwen/qwen3.7-max"

[dev]
build = [ "pnpm", "install" ]
run = [ "pnpm", "run", "dev" ]

[deploy]
build = [ "sh", "-c", "npm install && npm run build" ]
run = [ "sh", "-c", "npm start" ]
